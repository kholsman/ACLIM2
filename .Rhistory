HCR = "HCR7c: SR cov effects uneven omega", HCRscen="HCR7", subtxt = "c"))%>%
mutate(HCR = factor(HCR,levels=HCR_levels),
HCRscen = factor(HCRscen,levels=HCRscen_levels),
subtxt = factor(subtxt,levels=subtxt_levels))
