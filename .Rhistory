strata <- LETTERS[1:4]
bins   <- 1:5
species <- "plk"
years   <- 2001:2006
area <- data.frame(strata,area = round(rnorm(length(strata),100, 20)))
biomass <- bins*100
df <- expand.grid(strata,bins)
i <- 0
for(y in years){
i <- i + 1
if(i==1){
df <- expand.grid(strata,bins)
df$year <- y
out <- df
}else{
df <- expand.grid(strata,bins)
df$year <- y
out <- rbind(out,df)
}
}
